{
    "manifest_version": 3,
    "name": "TranslateYourReviews",
    "version": "1.0",
    "description": "",
    "background": {
        "scripts": [
            "background.js"
        ],
        "type": "module"
    },
    "icons": {
        "48": "icons/48.png",
        "128": "icons/128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "configuration.html"
            ],
            "matches": [
                "*://rateyourmusic.com/account/preferences"
            ]
        }
    ],
    "content_scripts": [
        {
            "matches": [
                "*://rateyourmusic.com/release/*"
            ],
            "js": [
                "translate.js"
            ]
        },
        {
            "matches": [
                "*://rateyourmusic.com/account/preferences"
            ],
            "js": [
                "options.js"
            ]
        },
        {
            "matches": [
                "*://rateyourmusic.com/account/account_edit"
            ],
            "js": [
                "profileOptions.js"
            ]
        }
    ],
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://api-free.deepl.com/*"
    ]
}