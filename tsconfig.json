{
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "types": ["firefox-webext-browser"],
    "lib": ["DOM", "ESNext"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "strict": false,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  }
}
